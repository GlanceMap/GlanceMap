<?xml version="1.0" encoding="utf-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="5"
    map-background="#eeeade" map-background-outside="#e5e4dc">
    <rule e="way" k="landuse|natural" v="forest|wood">
        <area fill="#cedac5" />
    </rule>
    <rule e="way" k="natural" v="scrub|heath|grassland|fell">
        <area fill="#dfe5d1" />
    </rule>
    <rule e="way" k="natural" v="bare_rock|scree|shingle">
        <area fill="#dbd7cf" />
    </rule>
    <rule e="way" k="natural" v="glacier">
        <area fill="#e8f1ef" />
    </rule>
    <rule e="way" k="natural|landuse" v="water|reservoir|basin">
        <area fill="#a9cdd7" />
    </rule>
    <rule e="way" k="waterway" v="river|stream">
        <line stroke="#83b8c6" stroke-width="1" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_major">
        <line stroke="#b7a99a" stroke-width="0.5" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_medium" zoom-min="13">
        <line stroke="#c9bfb1" stroke-width="0.3" />
    </rule>
    <rule e="way" k="highway" v="motorway|trunk|primary|secondary|tertiary|unclassified|residential|service">
        <line stroke="#c6bcb0" stroke-width="1.5" />
    </rule>
    <rule e="way" k="highway" v="track|path|footway|bridleway|steps|ladder" zoom-min="12">
        <line stroke="#795e4b" stroke-width="1.5" />
    </rule>
    <rule e="node" k="natural" v="peak" zoom-min="11">
        <circle radius="2" fill="#5f4e44" stroke="#ffffff" stroke-width="1" />
        <caption k="name" font-size="11" fill="#3f3832" stroke="#f7f4eb" stroke-width="2" dy="-6" />
        <caption k="ele" font-size="9" fill="#62584e" stroke="#f7f4eb" stroke-width="2" dy="8" />
    </rule>
    <rule e="node" k="mountain_pass" v="yes" zoom-min="13">
        <caption k="name" font-size="10" fill="#62584e" stroke="#f7f4eb" stroke-width="2" />
    </rule>
</rendertheme>
