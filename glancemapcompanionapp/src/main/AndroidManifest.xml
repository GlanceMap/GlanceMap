<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Companion fallbacks still work when native map picking or device location is unavailable. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x400003"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_companionapp"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_companionapp_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlanceMap"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.gms.wearable.CHANNEL_BUFFER_SIZE"
            android:value="${channelBufferSize}" />

        <activity
            android:name=".MainActivityMobile"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.GlanceMap">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- GPX: preferred MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/gpx+xml" />
                <data
                    android:scheme="file"
                    android:mimeType="application/gpx+xml" />
            </intent-filter>

            <!-- GPX: common alternate MIME types from chat/cloud providers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/x-gpx+xml" />
                <data
                    android:scheme="file"
                    android:mimeType="application/x-gpx+xml" />
                <data
                    android:scheme="content"
                    android:mimeType="application/gpx" />
                <data
                    android:scheme="file"
                    android:mimeType="application/gpx" />
                <data
                    android:scheme="content"
                    android:mimeType="application/x-gpx" />
                <data
                    android:scheme="file"
                    android:mimeType="application/x-gpx" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/xml" />
                <data
                    android:scheme="content"
                    android:mimeType="text/xml" />
                <data
                    android:scheme="file"
                    android:mimeType="application/xml" />
                <data
                    android:scheme="file"
                    android:mimeType="text/xml" />
            </intent-filter>

            <!-- WhatsApp/Chrome can expose GPX downloads as generic binary content. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream" />
                <data
                    android:scheme="file"
                    android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Chrome download notifications may expose DownloadsProvider content with */*. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="downloads"
                    android:mimeType="*/*" />
                <data
                    android:scheme="content"
                    android:host="com.android.providers.downloads.documents"
                    android:mimeType="*/*" />
            </intent-filter>

            <!-- Same DownloadsProvider fallback when Chrome omits the MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="downloads" />
                <data
                    android:scheme="content"
                    android:host="com.android.providers.downloads.documents" />
            </intent-filter>

            <!-- GPX: fallback when file managers use */* but the path contains .gpx -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:pathPattern="/.*\\.gpx" />
                <data
                    android:scheme="file"
                    android:pathPattern="/.*\\.gpx" />
            </intent-filter>

            <!-- GPX: Chrome download notifications commonly include a generic MIME with the .gpx path. -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern="/.*\\.gpx" />
            </intent-filter>

            <!-- MAP: most providers use */* so we match by extension -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:pathPattern="/.*\\.map" />
                <data
                    android:scheme="file"
                    android:pathPattern="/.*\\.map" />
            </intent-filter>

            <!-- MAP: specific MIME fallback without claiming every generic binary file -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.mapsforge.map" />
                <data
                    android:scheme="file"
                    android:mimeType="application/vnd.mapsforge.map" />
            </intent-filter>

            <!-- Optional: uppercase extensions (some file managers) -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:pathPattern="/.*\\.GPX" />
                <data
                    android:scheme="file"
                    android:pathPattern="/.*\\.GPX" />
            </intent-filter>

            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern="/.*\\.GPX" />
            </intent-filter>

            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:pathPattern="/.*\\.MAP" />
                <data
                    android:scheme="file"
                    android:pathPattern="/.*\\.MAP" />
            </intent-filter>

            <!-- Receive GPX streams from share sheets and providers that use ACTION_SEND. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/x-gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/x-gpx" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>

        <activity
            android:name=".PrivacyPolicyActivity"
            android:exported="false"
            android:label="@string/settings_credits_legal_title"
            android:theme="@style/Theme.GlanceMap" />

        <service
            android:name=".transfer.service.FileTransferService"
            android:foregroundServiceType="dataSync|connectedDevice"
            android:exported="false" />

        <service
            android:name=".livetracking.LiveTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <service
            android:name=".diagnostics.DiagnosticsEmailListenerService"
            android:exported="true"
            tools:ignore="WearableBindListener">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>

        <service
            android:name=".transfer.WatchGpxExportListenerService"
            android:exported="true"
            tools:ignore="WearableBindListener">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
