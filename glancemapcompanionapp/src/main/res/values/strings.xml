    <string name="quick_guide_transfer_files_gpx">.gpx = route/track</string>
    <string name="quick_guide_transfer_files_routing">.rd5 = offline routing tile</string>
    <string name="quick_guide_transfer_files_elevation">.hgt / .hgt.zip / .hgt.gz = elevation data for hill shading / slope</string>
    <string name="quick_guide_transfer_watch_title">Prepare the watch</string>
    <string name="quick_guide_transfer_watch_open">Open GlanceMap on the watch and keep it near the phone.</string>
    <string name="quick_guide_transfer_watch_large_files">For large transfers, charge the watch and use the same Wi-Fi or phone hotspot.</string>
    <string name="quick_guide_transfer_watch_bluetooth">Without Wi-Fi, Bluetooth can send files up to 50 MB.</string>
