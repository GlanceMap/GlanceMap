    <string name="quick_guide_transfer_files_title">Get files ready</string>
    <string name="quick_guide_transfer_files_download">Use 1. Download to get Mapsforge OSM .map, POI, GPX, or routing files.</string>
    <string name="quick_guide_transfer_files_select">Tap 2. Select file(s) to add files from the phone:</string>
