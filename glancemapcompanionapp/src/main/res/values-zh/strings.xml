    <string name="quick_guide_stay_open">• 点按 %1$s 工具，然后点按 %2$s 保持。你也可以启用常亮显示。</string>
    <string name="quick_guide_transfer_files_title">准备文件</string>
    <string name="quick_guide_transfer_files_download">使用 1. 下载 获取 Mapsforge OSM .map、兴趣点、GPX 或路线规划文件。</string>
    <string name="quick_guide_transfer_files_select">点按 2. 选择文件 以从手机添加文件：</string>
    <string name="quick_guide_transfer_files_map">.map = 离线地图</string>
    <string name="quick_guide_transfer_files_poi">.poi = 兴趣点</string>
    <string name="quick_guide_transfer_files_gpx">.gpx = 路线/轨迹</string>
    <string name="quick_guide_transfer_files_routing">.rd5 = 离线路线规划瓦片</string>
    <string name="quick_guide_transfer_files_elevation">.hgt / .hgt.zip / .hgt.gz = 用于山体阴影/坡度的海拔数据</string>
    <string name="quick_guide_transfer_watch_title">准备手表</string>
    <string name="quick_guide_transfer_watch_open">在手表上打开 GlanceMap，并将其靠近手机。</string>
    <string name="quick_guide_transfer_watch_large_files">传输大文件时，请为手表充电，并使用同一 Wi-Fi 或手机热点。</string>
    <string name="quick_guide_transfer_watch_bluetooth">没有 Wi-Fi 时，蓝牙可发送最大 50 MB 的文件。</string>
    <string name="quick_guide_transfer_areas_title">兴趣点与路线规划区域</string>
    <string name="quick_guide_transfer_areas_choose">下载兴趣点和路线规划时，请先选择所需区域。</string>
    <string name="quick_guide_transfer_areas_poi">兴趣点会下载 OSM 兴趣点。</string>
    <string name="quick_guide_transfer_areas_routing">路线规划会下载用于在手表上离线创建 GPX 路线的数据。</string>
    <string name="quick_guide_transfer_areas_map">你可以在地图上选择区域，或选取一个地区。</string>
    <string name="quick_guide_transfer_areas_refresh">刷新上次导入 会重复上一次的区域。</string>
    <string name="quick_guide_transfer_send_title">发送</string>
    <string name="quick_guide_transfer_send_close">点按发送，并保持手机与手表靠近，直到完成。</string>
    <string name="quick_guide_transfer_send_resume">如果中断，请再次发送同一文件；通常会从手表上已有的部分文件继续。</string>
    <string name="quick_guide_transfer_send_history">历史记录会显示每次传输的状态。</string>
    <string name="quick_guide_live_tracking_start_title">开始使用</string>
    <string name="quick_guide_live_tracking_start_intro">实时追踪由 Arkluz 提供。GlanceMap 作为手机端界面进行配置。</string>
    <string name="quick_guide_live_tracking_start_setup">点按设置实时追踪。</string>
    <string name="quick_guide_live_tracking_start_group">连接到现有私密群组或创建一个新群组。</string>
    <string name="quick_guide_live_tracking_start_options">添加你的姓名、GPS 更新频率和安全警报。</string>
    <string name="quick_guide_live_tracking_updates_title">分享更新</string>
    <string name="quick_guide_live_tracking_updates_plan">可选上传 GPX 路线或添加备注，发送给联系人。</string>
    <string name="quick_guide_live_tracking_updates_start">开始追踪。</string>
    <string name="quick_guide_live_tracking_updates_change">追踪期间，你可以修改 GPX，并通过点击“发送更新”分享新备注。</string>
    <string name="quick_guide_live_tracking_links_title">轨迹链接</string>
    <string name="quick_guide_live_tracking_links_participant">参与者链接会打开你自己的实时轨迹。</string>
    <string name="quick_guide_live_tracking_links_group">群组链接会打开共享的群组地图。</string>
    <string name="quick_guide_live_tracking_links_share">使用“查看与分享”打开或分享你的实时追踪链接。</string>
