# Preserve the vendored Elevate snapshots exactly as supplied upstream.
app/src/main/assets/theme/elevate/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
app/src/main/assets/theme/elevate-winter/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
app/src/main/assets/theme/elevate-winter-white/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Gradle's Windows wrapper uses CRLF line endings.
gradlew.bat whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
